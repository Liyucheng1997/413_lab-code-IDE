{
  "name": "lumen-ide",
  "version": "1.5.1",
  "description": "Lumen IDE - 一个基于 Electron + Monaco 的多语言代码编辑器",
  "author": "Yucheng LI",
  "license": "MIT",
  "homepage": "https://github.com/Liyucheng1997/lumen-ide",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liyucheng1997/lumen-ide.git"
  },
  "keywords": [
    "ide",
    "editor",
    "electron",
    "monaco",
    "lsp",
    "dap",
    "debugger"
  ],
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "@anthropic-ai/sdk": "^1.3.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "monaco-editor": "^0.52.2",
    "pyright": "^1.1.414",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.liyucheng1997.lumen-ide",
    "productName": "Lumen IDE",
    "copyright": "Copyright © 2026 Yucheng LI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "!node_modules/monaco-editor/{esm,dev,min-maps}/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/{CHANGELOG,README,readme}.md"
    ],
    "asarUnpack": [
      "node_modules/pyright/**",
      "node_modules/@lydell/**"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Liyucheng1997",
        "repo": "lumen-ide"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen IDE",
      "uninstallDisplayName": "Lumen IDE",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "artifactName": "Lumen-IDE-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Lumen-IDE-${version}-portable.exe"
    }
  }
}
